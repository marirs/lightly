    "looks.recommended.notTailored" : {
      "comment" : "Honesty disclaimer shown above the Recommended grid. Spec section 7 requires Recommended to be scene-aware; scene classification is Phase 4, so the interface must not imply personalisation it has not performed. Remove this string only when classification is wired in.",
