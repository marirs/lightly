    "develop.stage.detail": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail"
          }
        }
      }
    },
    "develop.stage.exposure": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposure"
          }
        }
      }
    },
    "develop.stage.highlights": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights"
          }
        }
      }
    },
    "develop.stage.pending": {
      "comment": "VoiceOver value for a develop stage that has not run.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending"
          }
        }
      }
    },
    "develop.stage.shadows": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadows"
          }
        }
      }
    },
    "develop.stage.whiteBalance": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White balance"
          }
        }
      }
    },
    "editor.auto.failed.notice": {
      "comment": "Compact notice after the user chose Continue following a genuine Auto failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto couldn't be applied to this photo."
          }
        }
      }
    },
    "editor.auto.failed.title": {
      "comment": "Shown with Retry and Continue when Auto genuinely failed (not when no model ships).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto couldn't analyse this photo."
          }
        }
      }
    },
    "editor.auto.unavailable.notice": {
      "comment": "Compact notice: this build ships no Auto model. Must never imply the photo was enhanced.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto is unavailable: no Auto model in this build."
          }
        }
      }
    },
    "editor.back.accessibility": {
      "comment": "VoiceOver label for the editor back button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to start"
          }
        }
      }
    },
    "editor.chooseAnother": {
      "comment": "Button after the editor could not open a photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another photo"
          }
        }
      }
    },
    "editor.lookSlider.accessibility": {
      "comment": "VoiceOver label of the stepped Look slider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look"
          }
        }
      }
    },
    "editor.lookSlider.position": {
      "comment": "Position of the selected stop on the Look slider, e.g. '3 of 5'. Shown after the preset name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        }
      }
    },
    "editor.lookSlider.value": {
      "comment": "VoiceOver value of the Look slider: category label, stop name, stop number, stop count. E.g. \"Warm, Nordic Tone (10), 3 of 5\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$lld of %4$lld"
          }
        }
      }
    },
    "editor.looks.approximate.notice": {
      "comment": "Compact notice: at least one Look's status is not 'validated' (pack format 2).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks are approximate, not finished conversions."
          }
        }
      }
    },
    "editor.looks.changed.notice": {
      "comment": "Notice: a restored edit's Look exists in this build but with a different version (spec 4.5). %@ is the preset name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has changed since this edit, so it isn't applied."
          }
        }
      }
    },
    "editor.looks.noneInBuild": {
      "comment": "Shown when the build contains no Looks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Looks are available in this build."
          }
        }
      }
    },
    "editor.looks.unavailable.notice": {
      "comment": "Notice: a restored edit names a Look the pack does not have (spec 4.5). The photo is shown without it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edit's Look isn't in this build, so it isn't applied."
          }
        }
      }
    },
    "editor.photo.accessibility": {
      "comment": "VoiceOver label for the photograph in the editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photograph"
          }
        }
      }
    },
    "editor.photo.autoUnavailable.accessibility": {
      "comment": "VoiceOver value of the photo when Auto is unavailable and no Look is applied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto unavailable, no Look"
          }
        }
      }
    },
    "editor.photo.original.accessibility": {
      "comment": "VoiceOver label while Compare is showing the original.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original photograph"
          }
        }
      }
    },
    "editor.photo.originalBadge": {
      "comment": "Badge on the photo while Compare shows the original.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original"
          }
        }
      }
    },
    "editor.save.failed": {
      "comment": "VoiceOver announcement when Save copy fails; the reason is shown on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was not saved."
          }
        }
      }
    },
    "editor.save.saved": {
      "comment": "Save copy succeeded. Wording fixed by spec section 2 step 7.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a new photo. Original unchanged."
          }
        }
      }
    },
    "editor.save.saving": {
      "comment": "Save copy in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        }
      }
    },
    "editor.stop.auto": {
      "comment": "Label of stop 0 of every Look slider while an Auto correction is applied: no creative Look, Auto only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "editor.stop.original": {
      "comment": "Label of stop 0 of every Look slider while no Auto correction is applied (no Auto model, Auto unavailable, or Auto at strength 0): no creative Look, the original photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original"
          }
        }
      }
    },
    "editor.strength.label": {
      "comment": "Label of the optional Strength control for the applied Look.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength"
          }
        }
      }
    },
    "editor.strength.value": {
      "comment": "Strength as a percentage, e.g. '80%'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "error.action.dismiss": {
      "comment": "Dismiss action on the error alert.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "error.cloudFeatureUnavailable": {
      "comment": "Spec section 28: cloud-assisted feature unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cloud-assisted feature is unavailable right now. Everything on-device still works."
          }
        }
      }
    },
    "error.developFailed": {
      "comment": "Spec section 28: Develop pipeline failure. Reassures that the original is intact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developing did not finish. Your original photo is unchanged."
          }
        }
      }
    },
    "error.exportFailed": {
      "comment": "Recovery copy for a failed export.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo could not be exported. Your edit is safe — please try again."
          }
        }
      }
    },
    "error.insufficientMemory": {
      "comment": "Spec section 28: insufficient memory.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is too large to work on right now. Closing other apps may help."
          }
        }
      }
    },
    "error.modelUnavailable": {
      "comment": "Spec section 28: required model not available on this device tier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool is not available on this device."
          }
        }
      }
    },
    "error.multipleFacesDetected": {
      "comment": "Spec section 28: ambiguous target when several faces are present.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly found more than one face. Choose which person to work on."
          }
        }
      }
    },
    "error.networkInterrupted": {
      "comment": "Spec section 28: connection dropped mid-operation. Must state that credits were not consumed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was interrupted, so this edit was not completed. You have not been charged."
          }
        }
      }
    },
    "error.noFaceDetected": {
      "comment": "Spec section 28: portrait tool invoked with no face present.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly did not find a face in this photo, so portrait tools are unavailable here."
          }
        }
      }
    },
    "error.permissionDenied": {
      "comment": "Recovery copy when Photos add-only access is denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly needs permission to add photos to your library. You can grant it in Settings."
          }
        }
      }
    },
    "error.photoLoadingFailed": {
      "comment": "Spec section 28: failed photo loading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo could not be opened. Try again, or choose another one."
          }
        }
      }
    },
    "error.rawFileTooLarge": {
      "comment": "Spec section 28: RAW file exceeds device budget.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This RAW file is larger than this device can develop at full size. Lightly can work on a reduced version instead."
          }
        }
      }
    },
    "error.storageFull": {
      "comment": "Recovery copy for a full device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough space to save this photo. Free up some space and try again."
          }
        }
      }
    },
    "error.title": {
      "comment": "Title of the recoverable error alert.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something needs your attention"
          }
        }
      }
    },
    "error.unsupportedImageFormat": {
      "comment": "Spec section 28: unsupported image format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is in a format Lightly cannot open yet. Try choosing another one."
          }
        }
      }
