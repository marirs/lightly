{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "about.title": {
      "comment": "More › About.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "about.version %@ %@": {
      "comment": "About: version and build from the bundle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "action.compare": {
      "comment": "Compare action label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare"
          }
        }
      }
    },
    "action.compare.accessibility": {
      "comment": "VoiceOver label for Compare. Wording specified in spec section 4.5.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show original photograph"
          }
        }
      }
    },
    "action.compare.hint": {
      "comment": "VoiceOver hint of the Compare toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the original photo until you turn Compare off. You can also press and hold the photo."
          }
        }
      }
    },
    "action.continueWithoutAuto": {
      "comment": "Continues editing without Auto after a genuine failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without Auto"
          }
        }
      }
    },
    "action.redo": {
      "comment": "Redo action label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo"
          }
        }
      }
    },
    "action.reset": {
      "comment": "Reset to Auto: removes the Look, keeps Auto. Short visible label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        }
      }
    },
    "action.reset.accessibility": {
      "comment": "VoiceOver label of Reset.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to Auto"
          }
        }
      }
    },
    "action.retry": {
      "comment": "Runs Auto again after a genuine failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        }
      }
    },
    "action.saveCopy": {
      "comment": "Saves the edit as a new photo; the original is never changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save copy"
          }
        }
      }
    },
    "action.undo": {
      "comment": "Undo the last committed edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        }
      }
    },
    "action.useCurrentVersion": {
      "comment": "Button on the 'Look changed' notice. Applies the pack's current version of the Look as a new, undoable step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use current version"
          }
        }
      }
    },
    "appearance.dark": {
      "comment": "Dark appearance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        }
      }
    },
    "appearance.light": {
      "comment": "Light appearance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        }
      }
    },
    "appearance.system": {
      "comment": "Appearance follows the system setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
    "border.none": {
      "comment": "No border.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        }
      }
    },
    "border.note": {
      "comment": "Preferred border page note.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens first in Border. It is never added to a photo automatically."
          }
        }
      }
    },
    "border.photoFrame": {
      "comment": "Photo Frame border.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Frame"
          }
        }
      }
    },
    "border.polaroid": {
      "comment": "Polaroid border.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaroid"
          }
        }
      }
    },
    "border.solid": {
      "comment": "Solid border.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid"
          }
        }
      }
    },
    "border.title": {
      "comment": "Preferences row and page title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred border"
          }
        }
      }
    },
    "brand.wordmark": {
      "comment": "The Lightly wordmark on the launch screen. Product name — do not translate.",
      "extractionState": "manual",
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly"
          }
        }
      }
    },
    "camera.unavailable.title": {
      "comment": "Alert when Camera is chosen on a device without one (the simulator).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is available on this device."
          }
        }
      }
    },
    "cameraOff.choosePhoto": {
      "comment": "Opens the system photo picker from the camera-denied screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo instead"
          }
        }
      }
    },
    "cameraOff.message": {
      "comment": "Explanation on the camera-denied screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To take a photo in Lightly, allow camera access in Settings. You can still choose a photo from your library."
          }
        }
      }
    },
    "cameraOff.openSettings": {
      "comment": "Opens Lightly in the Settings app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "cameraOff.title": {
      "comment": "Title of the screen shown when camera permission is denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        }
      }
    },
    "common.back": {
      "comment": "Back button on a page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "common.close": {
      "comment": "Close button on a page or screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "common.ok": {
      "comment": "Acknowledges a plain alert.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "develop.progress.title": {
      "comment": "Title of the developing overlay. Spec section 4.4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developing…"
          }
        }
      }
    },
    "develop.stage.clarity": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clarity"
          }
        }
      }
    },
    "develop.stage.colour": {
      "comment": "Develop pipeline stage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour"
          }
        }
      }
    },
