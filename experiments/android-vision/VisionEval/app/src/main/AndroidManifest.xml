<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy check built into the harness: the evaluation app has NO network access. ML Kit and
         MediaPipe both pull in Firelog/datatransport (usage telemetry) which merges INTERNET and
         ACCESS_NETWORK_STATE into the manifest; they are removed here so every bundled candidate is
         proven to work fully offline from this process. The ML Kit Subject Segmentation model is
         downloaded by the Google Play services process, not by this app, so it is unaffected. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:label="VisionEval"
        android:largeHeap="true"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
