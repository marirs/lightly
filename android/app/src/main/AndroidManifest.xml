<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage or media permissions: selection uses the Photo Picker and saving inserts into
         MediaStore, both permissionless on API 29+ (spec §2, §5.4).
         CAMERA: declared so the approved permission flow (camera-permission / camera-denied) is
         the system's own. The capture itself is the system camera app (ACTION_IMAGE_CAPTURE), which
         requires this permission to be granted once the app declares it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Lets TakePicture find the system camera app on API 30+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Lightly"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lightly">
        <!-- No configChanges override: rotation/fold recreate the Activity on purpose, and the
             ViewModels + SavedStateHandle carry the session and navigation across (spec §5.5).
             Orientation is requested at runtime (OrientationPolicy): portrait on phone-sized
             displays, free on unfolded foldables and tablets. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Camera captures are written by the system camera into cache/captures through this
             provider, and Share hands over its copy of the last saved file from cache/share
             (read-only grants); nothing else is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>
    </application>
</manifest>
