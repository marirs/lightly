{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lightly:contracts/edit-recipe-v1.json",
 "title": "Lightly edit recipe v1 (EditState schema 3)",
 "description": "One committed edit covering every tool. Schema 3 = EditState schema 2 (source, auto, look, revision; unchanged keys and semantics) plus recipeVersion and tools. Preview and export evaluate the same committed recipe in rendering-v2 stage order; undo/redo store whole recipes. Strict: unknown keys are rejected, every key is present, and nothing outside a range is clamped on read. Encoding is canonical: keys in the order listed here, no whitespace, integers without a decimal point.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "recipeVersion", "source", "auto", "look", "revision", "tools"],
 "properties": {
  "schema": {"const": 3, "description": "EditState schema. 1 and 2 are migrated on read (see shared/fixtures/edit-recipe/README.md); anything else is rejected."},
  "recipeVersion": {"const": 1, "description": "Version of this tool-section contract."},
  "source": {"$ref": "#/$defs/source"},
  "auto": {"$ref": "#/$defs/auto"},
  "look": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lookRef"}], "description": "Develop look and its Amount (strength = Amount / 100). null = no Look (Auto or Original)."},
  "revision": {"type": "integer", "minimum": 0},
  "tools": {"$ref": "#/$defs/tools"}
 },
 "$defs": {
  "unit": {"type": "number", "minimum": 0, "maximum": 1},
  "percent": {"type": "number", "minimum": 0, "maximum": 100},
  "slider": {"type": "number", "minimum": -100, "maximum": 100},
  "colour": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "point": {"type": "array", "prefixItems": [{"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/unit"}], "minItems": 2, "maxItems": 2,
            "description": "[x, y] normalised, origin top-left"},
  "rect": {"type": "array", "prefixItems": [{"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/unit"}],
           "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] normalised; x + w <= 1 and y + h <= 1 are checked by readers"},
  "modelRef": {"type": "object", "additionalProperties": false, "required": ["id", "version"],
               "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
  "derivedRef": {
   "description": "A cached result of an on-device model (matte, depth map, inpainted patch), stored beside the edit by digest. Missing cache: recompute only with the same model id and version; otherwise the tool shows its unavailable state. Never silently recomputed with a different model.",
   "type": "object", "additionalProperties": false, "required": ["sha256", "model", "width", "height"],
   "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "model": {"$ref": "#/$defs/modelRef"},
                  "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
  "assetRef": {
   "description": "An image the user chose (background image, logo). bundled: shipped with the app; photo: another library photo (same fingerprint rule as source); file: imported bytes stored beside the edit by digest.",
   "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["kind", "id"],
     "properties": {"kind": {"const": "bundled"}, "id": {"type": "string", "minLength": 1}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "assetId", "fingerprint"],
     "properties": {"kind": {"const": "photo"}, "assetId": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "sha256"],
     "properties": {"kind": {"const": "file"}, "sha256": {"$ref": "#/$defs/sha256"}}}]},

  "fingerprint": {"type": "object", "additionalProperties": false, "required": ["headSha256", "byteSize", "pixelWidth", "pixelHeight"],
                  "properties": {"headSha256": {"$ref": "#/$defs/sha256"}, "byteSize": {"type": "integer", "minimum": 0},
                                 "pixelWidth": {"type": "integer", "minimum": 1}, "pixelHeight": {"type": "integer", "minimum": 1}}},
  "source": {"description": "Unchanged from EditState schema 2.", "type": "object", "additionalProperties": false,
             "required": ["assetId", "fingerprint", "orientation"],
             "properties": {"assetId": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"},
                            "orientation": {"type": "integer", "minimum": 1, "maximum": 8}}},
  "auto": {"description": "Unchanged from EditState schema 2 (stage `auto`). modelVersion no-model-in-build means Auto was never applied.",
           "type": "object", "additionalProperties": false, "required": ["modelId", "modelVersion", "weights", "guardrail", "strength"],
           "properties": {"modelId": {"type": "string", "minLength": 1}, "modelVersion": {"type": "string", "minLength": 1},
                          "weights": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                          "guardrail": {"oneOf": [{"type": "null"}, {"enum": ["endpoint-v1"]}]},
                          "strength": {"$ref": "#/$defs/unit"}}},
  "lookRef": {"description": "Unchanged from EditState schema 2. lookId = pack preset id; lookVersion = the pack's lookVersion (rendering-v2.json). Resolution: id not in the pack -> unavailable; version differs (including legacy-v1-*) -> changed, rendered without the Look until the user accepts the current version as a new undoable step; never substitute.",
              "type": "object", "additionalProperties": false, "required": ["lookId", "lookVersion", "strength"],
              "properties": {"lookId": {"type": "string", "minLength": 1}, "lookVersion": {"type": "string", "minLength": 1},
                             "strength": {"$ref": "#/$defs/unit"}}},

  "tools": {"type": "object", "additionalProperties": false,
            "required": ["background", "portrait", "edit", "effects", "watermark", "border"],
            "properties": {"background": {"$ref": "#/$defs/background"}, "portrait": {"$ref": "#/$defs/portrait"},
                           "edit": {"$ref": "#/$defs/edit"}, "effects": {"$ref": "#/$defs/effects"},
                           "watermark": {"$ref": "#/$defs/watermark"}, "border": {"$ref": "#/$defs/border"}}},

  "background": {"type": "object", "additionalProperties": false, "required": ["subject", "replacement", "focus"],
                 "properties": {"subject": {"$ref": "#/$defs/subject"},
                                "replacement": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/replacement"}]},
                                "focus": {"$ref": "#/$defs/focus"}}},
  "subject": {"description": "Subject separation shared by replacement and focus. matte null = not computed yet (both tools neutral).",
              "type": "object", "additionalProperties": false, "required": ["matte", "refinements"],
              "properties": {"matte": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/derivedRef"}]},
                             "refinements": {"type": "array", "items": {"$ref": "#/$defs/refineStroke"}}}},
  "refineStroke": {"description": "Refine edges: add to or remove from the subject. Points in source coordinates; radius as a fraction of the source long edge.",
                   "type": "object", "additionalProperties": false, "required": ["mode", "radius", "points"],
                   "properties": {"mode": {"enum": ["add", "erase"]}, "radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
                                  "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 1}}},
  "replacement": {"oneOf": [
   {"type": "object", "additionalProperties": false, "required": ["kind", "image", "x", "y", "scale"],
    "properties": {"kind": {"const": "image"}, "image": {"$ref": "#/$defs/assetRef"},
                   "x": {"$ref": "#/$defs/percent"}, "y": {"$ref": "#/$defs/percent"},
                   "scale": {"type": "number", "minimum": 100, "maximum": 200}}},
   {"type": "object", "additionalProperties": false, "required": ["kind", "colour"],
    "properties": {"kind": {"const": "colour"}, "colour": {"$ref": "#/$defs/colour"}}},
   {"type": "object", "additionalProperties": false, "required": ["kind", "angle", "stops"],
    "properties": {"kind": {"const": "gradient"}, "angle": {"type": "number", "minimum": 0, "maximum": 360},
                   "stops": {"type": "array", "minItems": 2, "maxItems": 8,
                             "items": {"type": "object", "additionalProperties": false, "required": ["colour", "position"],
                                       "properties": {"colour": {"$ref": "#/$defs/colour"}, "position": {"$ref": "#/$defs/unit"}}}}}}]},
  "focus": {"description": "Focus & Blur (stage background.focus). Depth-aware: the circle of confusion grows with |depth - focusDepth| beyond the depth of field. Applies to the replaced background too (at depth.replacementDepth).",
            "type": "object", "additionalProperties": false,
            "required": ["blur", "depthOfField", "style", "bokeh", "styleAmount", "target", "depth"],
            "properties": {"blur": {"$ref": "#/$defs/percent"},
                           "depthOfField": {"$ref": "#/$defs/percent", "description": "The 'Focus depth' slider: how much depth around the focus stays sharp."},
                           "style": {"enum": ["lens", "soft", "swirl", "motion"]},
                           "bokeh": {"enum": ["round", "hex", "heart", "star"], "description": "Used by the lens style."},
                           "styleAmount": {"$ref": "#/$defs/percent", "description": "soft: glow; swirl: swirl; motion: direction (degrees = styleAmount * 3.6 - 180)."},
                           "target": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/point"}], "description": "Tap-to-focus point in source coordinates; null = the subject."},
                           "depth": {"$ref": "#/$defs/depth"}}},
  "depth": {"description": "Where depth comes from, distinct from the subject matte. embedded: the photo's own depth/disparity map; estimated: a monocular depth model (dependency D5); subject-matte: no depth, two planes (subject sharp, everything else at replacementDepth).",
            "type": "object", "additionalProperties": false, "required": ["source", "map", "focusDepth", "replacementDepth"],
            "properties": {"source": {"enum": ["embedded", "estimated", "subject-matte"]},
                           "map": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/derivedRef"}], "description": "Normalised depth map (0 near, 1 far); null for subject-matte."},
                           "focusDepth": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/unit"}], "description": "Depth at the focus target, resolved when the target was set and stored so a replay never re-resolves it; null = the subject's median depth."},
                           "replacementDepth": {"$ref": "#/$defs/unit", "description": "Depth assigned to a replaced background (default 1, far)."}}},

  "portrait": {"type": "object", "additionalProperties": false, "required": ["faces"],
               "properties": {"faces": {"type": "array", "items": {"$ref": "#/$defs/faceEdit"}, "maxItems": 16,
                                        "description": "One entry per detected face, each with its own settings. Faces with no change may be omitted."}}},
  "faceEdit": {"type": "object", "additionalProperties": false, "required": ["face", "skin", "underEye", "eyes", "teeth", "hair"],
               "properties": {
                "face": {"type": "object", "additionalProperties": false, "required": ["box", "detector"],
                         "description": "Identity of the face: its detected box in source coordinates and the detector that found it. On reopen a face is matched by box overlap (IoU >= 0.5) with the same detector; an unmatched entry is kept and reported, never moved to another face.",
                         "properties": {"box": {"$ref": "#/$defs/rect"}, "detector": {"$ref": "#/$defs/modelRef"}}},
                "skin": {"type": "object", "additionalProperties": false, "required": ["smoothing", "blemishes", "evenTone", "keepTexture"],
                         "properties": {"smoothing": {"$ref": "#/$defs/percent"}, "blemishes": {"$ref": "#/$defs/percent"},
                                        "evenTone": {"$ref": "#/$defs/percent"}, "keepTexture": {"$ref": "#/$defs/percent"}}},
                "underEye": {"type": "object", "additionalProperties": false, "required": ["brighten", "softenLines"],
                             "properties": {"brighten": {"$ref": "#/$defs/percent"}, "softenLines": {"$ref": "#/$defs/percent"}}},
                "eyes": {"type": "object", "additionalProperties": false, "required": ["brighten", "clarity"],
                         "properties": {"brighten": {"$ref": "#/$defs/percent"}, "clarity": {"$ref": "#/$defs/percent"}}},
                "teeth": {"type": "object", "additionalProperties": false, "required": ["brighten"],
                          "properties": {"brighten": {"$ref": "#/$defs/percent"}}},
                "hair": {"type": "object", "additionalProperties": false, "required": ["definition", "flyaways", "shine"],
                         "properties": {"definition": {"$ref": "#/$defs/percent"}, "flyaways": {"$ref": "#/$defs/percent"},
                                        "shine": {"$ref": "#/$defs/percent"}}}}},

  "edit": {"type": "object", "additionalProperties": false, "required": ["geometry", "adjust", "remove"],
           "properties": {"geometry": {"$ref": "#/$defs/geometry"}, "adjust": {"$ref": "#/$defs/adjust"}, "remove": {"$ref": "#/$defs/remove"}}},
  "geometry": {"description": "Applied in this order in the displayed frame: quarterTurns, flips, perspective, straighten (auto-zoom so no empty corner shows), crop.",
               "type": "object", "additionalProperties": false,
               "required": ["quarterTurns", "flipHorizontal", "flipVertical", "perspective", "straighten", "crop"],
               "properties": {"quarterTurns": {"type": "integer", "minimum": 0, "maximum": 3},
                              "flipHorizontal": {"type": "boolean"}, "flipVertical": {"type": "boolean"},
                              "perspective": {"type": "object", "additionalProperties": false, "required": ["vertical", "horizontal"],
                                              "properties": {"vertical": {"$ref": "#/$defs/slider"}, "horizontal": {"$ref": "#/$defs/slider"}}},
                              "straighten": {"type": "number", "minimum": -45, "maximum": 45},
                              "crop": {"type": "object", "additionalProperties": false, "required": ["aspect", "rect"],
                                       "properties": {"aspect": {"enum": ["original", "free", "1:1", "4:5", "3:2", "16:9", "9:16"]},
                                                      "rect": {"$ref": "#/$defs/rect", "description": "In the straightened frame; [0, 0, 1, 1] = uncropped."}}}}},
  "adjust": {"type": "object", "additionalProperties": false,
             "required": ["exposure", "contrast", "highlights", "shadows", "temp", "tint", "saturation", "vibrance", "sharpness", "clarity", "noise"],
             "properties": {"exposure": {"$ref": "#/$defs/slider"}, "contrast": {"$ref": "#/$defs/slider"},
                            "highlights": {"$ref": "#/$defs/slider"}, "shadows": {"$ref": "#/$defs/slider"},
                            "temp": {"$ref": "#/$defs/slider"}, "tint": {"$ref": "#/$defs/slider"},
                            "saturation": {"$ref": "#/$defs/slider"}, "vibrance": {"$ref": "#/$defs/slider"},
                            "sharpness": {"$ref": "#/$defs/percent"}, "clarity": {"$ref": "#/$defs/slider"},
                            "noise": {"$ref": "#/$defs/percent"}}},
  "remove": {"type": "object", "additionalProperties": false, "required": ["strokes"],
             "properties": {"strokes": {"type": "array", "items": {"$ref": "#/$defs/removeStroke"},
                                        "description": "In the order applied; Undo stroke removes the last."}}},
  "removeStroke": {"type": "object", "additionalProperties": false, "required": ["radius", "points", "result"],
                   "properties": {"radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "Brush radius, fraction of the source long edge."},
                                  "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 1, "description": "Source coordinates."},
                                  "result": {"type": "object", "additionalProperties": false, "required": ["status", "patch"],
                                             "properties": {"status": {"enum": ["applied", "failed", "unavailable"]},
                                                            "patch": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/derivedRef"}],
                                                                      "description": "The inpainted area; null unless applied."}}}}},

  "effects": {"type": "object", "additionalProperties": false, "required": ["lightLeak", "grain", "vignette"],
              "description": "Added on top of the preset's own grain/vignette (recipe.finishing), never replacing them.",
              "properties": {
               "lightLeak": {"type": "object", "additionalProperties": false, "required": ["enabled", "style", "intensity", "x", "y", "rotation"],
                             "properties": {"enabled": {"type": "boolean"}, "style": {"enum": ["warm", "amber", "rose", "prism"]},
                                            "intensity": {"$ref": "#/$defs/percent"}, "x": {"$ref": "#/$defs/percent"}, "y": {"$ref": "#/$defs/percent"},
                                            "rotation": {"type": "number", "minimum": -180, "maximum": 180}}},
               "grain": {"type": "object", "additionalProperties": false, "required": ["enabled", "style", "amount", "size", "roughness", "seed"],
                         "properties": {"enabled": {"type": "boolean"}, "style": {"enum": ["fine", "film", "coarse"]},
                                        "amount": {"$ref": "#/$defs/percent"}, "size": {"$ref": "#/$defs/percent"}, "roughness": {"$ref": "#/$defs/percent"},
                                        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Fixed when the edit is created so every render has the same grain."}}},
               "vignette": {"type": "object", "additionalProperties": false, "required": ["enabled", "amount", "size", "softness"],
                            "properties": {"enabled": {"type": "boolean"}, "amount": {"$ref": "#/$defs/percent"},
                                           "size": {"$ref": "#/$defs/percent"}, "softness": {"$ref": "#/$defs/percent"}}}}},

  "watermark": {"type": "object", "additionalProperties": false,
                "required": ["type", "signature", "text", "logo", "placement", "position", "offset", "size", "opacity", "colour"],
                "description": "Exactly the part matching `type` is non-null (checked by readers). placement border needs a border; without one the watermark renders on the photo.",
                "properties": {"type": {"enum": ["none", "signature", "text", "logo"]},
                               "signature": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/signatureRef"}]},
                               "text": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["text", "font"],
                                                                     "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 80},
                                                                                    "font": {"enum": ["Allura", "Cormorant Garamond", "Inter", "Caveat"]}}}]},
                               "logo": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["image"],
                                                                     "properties": {"image": {"$ref": "#/$defs/assetRef"}}}]},
                               "placement": {"enum": ["photo", "border"]},
                               "position": {"type": "integer", "minimum": 0, "maximum": 8, "description": "Anchor, row-major 3x3 (0 top left ... 8 bottom right)."},
                               "offset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/point"}], "description": "Dragged position (frame coordinates of the watermark's anchor); overrides position when set."},
                               "size": {"type": "number", "minimum": 10, "maximum": 80},
                               "opacity": {"$ref": "#/$defs/percent"},
                               "colour": {"$ref": "#/$defs/colour", "description": "Ink for text, logo and drawn signatures; imported signatures keep their own ink."}}},
  "signatureRef": {"description": "A saved signature in the app's storage. Same rule as a Look: id missing -> unavailable (rendered without it, notice shown); version differs -> changed (rendered without it until the user accepts the current version as a new undoable step); never substituted.",
                   "type": "object", "additionalProperties": false, "required": ["signatureId", "signatureVersion", "kind"],
                   "properties": {"signatureId": {"type": "string", "minLength": 1},
                                  "signatureVersion": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "First 12 hex digits of sha256 of the stored signature (vector strokes or imported image bytes)."},
                                  "kind": {"enum": ["drawn", "imported"]}}},

  "border": {"type": "object", "additionalProperties": false, "required": ["type", "colour", "width", "spacing", "mat"],
             "description": "Insets as fractions of the image width (rendering-v2 stage border). solid: colour, width 1..15; frame: colour (frame), width 1..10, mat colour, spacing 0..12; polaroid: colour, fixed margins; none: other fields kept at their last values and ignored. The polaroid 'signature on the margin' is watermark.placement = border.",
             "properties": {"type": {"enum": ["none", "solid", "frame", "polaroid"]}, "colour": {"$ref": "#/$defs/colour"},
                            "width": {"type": "number", "minimum": 1, "maximum": 15}, "spacing": {"type": "number", "minimum": 0, "maximum": 12},
                            "mat": {"$ref": "#/$defs/colour"}}}
 }
}
